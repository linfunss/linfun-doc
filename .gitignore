# Dependencies and package-manager state
node_modules/
.pnp.*
.pnpm-store/
.npm/
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/
# Keep package-lock.json, pnpm-lock.yaml and yarn.lock tracked.

# VitePress output and caches (root or nested documentation sites)
**/.vitepress/dist/
**/.vitepress/cache/
**/.vitepress/.temp/

# Build output and tool caches
dist/
build/
out/
.vite/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Test reports and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Local environment and secrets (keep sanitized examples)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
*.local
*.pem
*.key

# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.pid.lock
*.seed
report.*.json

# Editor and IDE local state
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.history/

# OS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*.rej
